# AI_API_KEY: Required for the optional AI-assisted diagram generation feature.
# This is a placeholder key.
# Users should set this to their own generative-AI API key from their chosen provider.
# IMPORTANT: Uncomment the line below if your app uses the AI diagram feature.
# If left commented out, the key will NOT be packaged in the APK.
AI_API_KEY=YOUR_AI_API_KEY
